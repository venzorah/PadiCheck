  "POST /v1/admin/billing/offers": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "offer_key": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,80}$"
      },
      "display_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "\\S"
      },
      "billing_mode": {
        "type": "string",
        "enum": [
          "one_time",
          "subscription"
        ]
      },
      "provider_product_id": {
        "type": "string",
        "pattern": "^prod_[a-zA-Z0-9_-]{1,200}$"
      },
      "currency": {
        "type": "string",
        "enum": [
          "USD",
          "NGN"
        ]
      },
      "amount": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"
      },
      "investigation_units": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100000
      },
      "is_enabled": {
        "type": "boolean",
        "default": false
      }
    },
    "required": [
      "offer_key",
      "display_name",
      "billing_mode",
      "provider_product_id",
      "currency",
      "amount",
      "investigation_units"
    ]
  },
